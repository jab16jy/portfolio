---
import { render, type CollectionEntry } from "astro:content";

interface Props {
  lang: "es" | "en";
  entry: CollectionEntry<"projects">;
}
const { lang, entry } = Astro.props;
const { Content, headings } = await render(entry);
const {
  title,
  summary,
  status,
  stack,
  finding,
  nodes,
  sources,
  image,
  imageAlt,
  demo,
} = entry.data;
const es = lang === "es";
const flow = es ? "Recorrido en el código" : "Path through the code";
const evidence = es ? "Fuentes y revisión" : "Sources and revision";
// Use a pinned source rather than treating the repository's current HEAD as audited.
const pinned = sources
  .map(({ url }) =>
    url.match(
      /^(https:\/\/github\.com\/[^/]+\/[^/]+)\/(?:blob|tree)\/([a-f0-9]{40})\//,
    ),
  )
  .find(Boolean);
if (!pinned?.[1] || !pinned[2])
  throw new Error(`Missing audited revision for ${entry.id}`);
const [, repo, revision] = pinned;
const sections = [
  { slug: "flow", text: flow },
  ...headings.filter(({ depth }) => depth === 2),
  { slug: "evidence", text: evidence },
];
---

<article class="wrap study" lang={lang}>
  <header>
    <p class="eyebrow">
      {es
        ? "Cuaderno de ingeniería · Caso de estudio"
        : "Engineering notebook · Case study"}
    </p>
    <h1>{title}</h1>
    <p class="lede">{summary}</p>
    <dl>
      <dt>{es ? "Estado" : "Status"}</dt>
      <dd>{status}</dd>
      <dt>{es ? "Tecnologías" : "Stack"}</dt>
      <dd>{stack.join(" · ")}</dd>
    </dl>
    <div class="actions">
      <a class="button" href={repo}>
        {es ? "Ver repositorio" : "View repository"}
      </a>
      {demo && (
        <a class="button" href={demo}>
          {es ? "Abrir demo" : "Open demo"}
        </a>
      )}
    </div>
  </header>
  <nav aria-label={es ? "Secciones del caso" : "Case study sections"}>
    <p class="eyebrow">{es ? "En esta página" : "On this page"}</p>
    <ul>
      {sections.map(({ slug, text }) => (
        <li>
          <a href={`#${slug}`}>{text}</a>
        </li>
      ))}
    </ul>
  </nav>
  <section aria-labelledby="flow">
    <h2 id="flow">{flow}</h2>
    <figure class="diagram">
      <figcaption>{finding}</figcaption>
      <ol role="list">
        {nodes.map((node, i) => (
          <li>
            <span aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            {node}
          </li>
        ))}
      </ol>
    </figure>
  </section>
  <div class="prose">
    <Content />
  </div>
  <section aria-labelledby="evidence">
    <h2 id="evidence">{evidence}</h2>
    <p>
      {es ? "Revisión auditada:" : "Audited revision:"}{" "}
      <a href={`${repo}/commit/${revision}`}>
        <code>{revision.slice(0, 8)}</code>
      </a>
    </p>
    <ul class="sources">
      {sources.map(({ url, label }) => (
        <li>
          <a href={url}>{label}</a>
        </li>
      ))}
    </ul>
    {image ? (
      <figure class="capture">
        <img src={image} alt={imageAlt} loading="lazy" decoding="async" />
        <figcaption>{entry.data.caption}</figcaption>
      </figure>
    ) : (
      <p class="note">
        {es
          ? "Captura pendiente. El esquema se basa en las fuentes enlazadas."
          : "Screenshot pending. The diagram is based on the linked sources."}
      </p>
    )}
  </section>
</article>

<style>
  .study {
    color: var(--ink);
    background: var(--paper);
    padding-block: clamp(2rem, 6vw, 6rem);
    overflow-wrap: anywhere;
  }
  header {
    max-width: 56rem;
  }
  dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.5rem 1rem;
  }
  dt,
  .note,
  .capture figcaption {
    color: var(--muted);
  }
  dt,
  .diagram li,
  code {
    font-family: var(--mono);
  }
  dd,
  figure {
    margin: 0;
  }
  .actions,
  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
  }
  nav,
  section {
    border-top: 1px solid var(--line);
    margin-top: 2.5rem;
    padding-top: 1.25rem;
  }
  nav ul {
    padding: 0;
    list-style: none;
  }
  nav a,
  .sources a {
    color: var(--ink);
  }
  .study :global(h2) {
    scroll-margin-top: 6rem;
  }
  .diagram {
    background: var(--panel);
    padding: clamp(1rem, 4vw, 2rem);
  }
  .diagram figcaption {
    font-size: 1.25rem;
    max-width: 58ch;
  }
  .diagram ol {
    padding: 0;
    margin: 1.5rem 0 0;
    list-style: none;
  }
  .diagram li {
    position: relative;
    display: flex;
    gap: 0.85rem;
    align-items: baseline;
    padding-bottom: 1rem;
  }
  .diagram li span {
    position: relative;
    z-index: 1;
    flex: none;
    color: var(--accent);
    background: var(--panel);
    border: 1px solid currentColor;
    padding: 0.15rem 0.4rem;
  }
  .diagram li:not(:last-child)::before {
    content: "";
    position: absolute;
    inset: 0.5rem auto -0.5rem 1rem;
    border-left: 1px solid var(--accent);
  }
  .diagram li:last-child {
    padding-bottom: 0;
  }
  .prose,
  .sources {
    max-width: 70ch;
  }
  .prose {
    margin-block: 3rem;
  }
  .sources li {
    margin-block: 0.6rem;
  }
  .capture {
    margin-top: 2rem;
  }
  .capture img {
    display: block;
    max-width: 100%;
    height: auto;
    border: 1px solid var(--line);
  }
  .capture figcaption {
    margin-top: 0.5rem;
  }
  .study :global(a:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  @media (max-width: 40rem) {
    nav ul {
      display: grid;
    }
    dl {
      grid-template-columns: 1fr;
    }
  }
</style>
